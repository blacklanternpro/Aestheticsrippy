{
  "id": "studio-neue",
  "name": "Studio Neue Invoice",
  "version": "1.0.0",
  "category": "Invoice & Billing",
  "description": "Ultra-clean Swiss modern graphic design studio invoice with oversized grotesque typography, tight tabular ledger, folio stamp, and ink signature.",
  "target": {
    "dimensions": {
      "format": "A4",
      "width_mm": 210,
      "height_mm": 297,
