      "top": 18,
      "right": 20,
      "bottom": 16,
      "left": 20
    }
  },
  "typography": {
    "primaryFont": "Inter",
    "displayFont": "Inter Tight",
    "monospaceFont": "Space Mono",
    "modularScale": 1.25,
    "lineHeightBase": 1.45
  },
  "colorTokens": {
    "background": "#ffffff",
    "textPrimary": "#0a0a0a",
    "textSecondary": "#555555",
    "textMuted": "#888888",
    "borderHairline": "#e5e5e5"
  },
  "spatialBudget": {
    "maxLineItems": 9,
    "maxNotesChars": 240,
    "strictSinglePage": true
  }
}
